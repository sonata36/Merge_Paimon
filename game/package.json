{
  "name": "merge-paimon-course-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:offline",
    "build:offline": "esbuild src/main.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=offline/game.js --minify --define:import.meta.env.DEV=false",
    "test": "node --experimental-strip-types --test tests/rules.test.mjs tests/compound.test.mjs tests/assets.test.mjs",
    "benchmark:physics": "node --experimental-strip-types tests/physics-benchmark.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
